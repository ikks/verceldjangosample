{
  "builds": [
    {
      "src": "api/wsgi",
      "use": "@vercel/python",
      "config":
      {
        "maxLambdaSize": "15mb"
      }
    },
    {
        "src": "setup.sh",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "staticfiles_build"
        }
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/staticfiles/favicon.ico"
    },
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/wsgi.py"
    }
  ]
}
